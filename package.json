{
  "name": "affiliate-partner-finder",
  "version": "1.0.1",
  "description": "Chrome MV3 extension: find affiliate/partner programs of Trustpilot companies with evidence.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "scan": "tsx cli/index.ts",
    "scan:xvfb": "tsx cli/index.ts --virtual-display",
    "cli": "tsx cli/index.ts",
    "desktop:dev": "electron --no-sandbox desktop/electron-dev.cjs",
    "desktop:bundle-cli": "node scripts/bundle-cli.mjs",
    "desktop:prepare-pack": "node scripts/prepare-desktop-pack.mjs",
    "desktop:pack": "npm run desktop:prepare-pack && electron-builder --config desktop/electron-builder.yml --win",
    "shard:scan": "node scripts/shard-scan.mjs",
    "shard:merge": "tsx scripts/merge-shards.ts",
    "shard:relaunch": "node scripts/shard-relaunch.mjs",
    "shard:watch": "node scripts/shard-watch.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "jsdom": "^25.0.0",
    "p-limit": "^7.3.1",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wxt": "^0.19.0"
  },
  "dependencies": {
    "idb": "^8.0.0"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
